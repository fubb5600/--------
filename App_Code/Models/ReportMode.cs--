    public ArrayList TDOSd005_Machine(Form form)
    {
        #region 修正惠爾查不到11/20_wenny1061222;新增零件編號欄位_wenny1061225
        String sql = @"select dbo.chineseDateTime(d.notify_date) as notify_date, d.machine_no, a.crs_org, b.notify_item, c.component_name, 
            c.unit, c.budget1, c.budget2, c.budget3, c.budget4, b.count, (c.budget1 * b.count) as total_price1, 
            (c.budget2 * b.count) as total_price2, (c.budget3 * b.count) as total_price3, (c.budget4 * b.count) as total_price4, a.repair_vender,
            a.case_no, a.work_no, b.repair_did, a.budget_area, d.machine_type ,b.component_no 
            from f_repair_mst a
